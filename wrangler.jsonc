{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "businesscom-mcp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "BUSINESSCOM_MCP", "class_name": "BusinessComMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BusinessComMcp"] }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "20f6af82d51843d494542bdf141b5a59" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "elty.cloudflareaccess.com",
    "ACCESS_AUD": "",
    // Sentinel = /mcp fails closed (403) because no Access app currently guards it.
    // Replace with the real AUD tag of the /mcp Access app (Service Auth policy).
    "ACCESS_MCP_AUD": "LOCKED-configure-access-app-for-mcp"
  },
  "observability": { "enabled": true }
}
