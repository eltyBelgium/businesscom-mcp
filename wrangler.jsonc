{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "businesscom-mcp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "BUSINESSCOM_MCP", "class_name": "BusinessComMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BusinessComMcp"] }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "20f6af82d51843d494542bdf141b5a59" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "elty.cloudflareaccess.com",
    // AUD tag of the Zero Trust Access app "businesscom-mcp /authorize" (identity Allow @elty.be)
    "ACCESS_AUD": "6c16f58e94bcb882cf2d6caf8cc656cc7151b90355e1c8876640ecffc5c33aa2",
    // AUD tag of the Access app "businesscom-mcp /mcp" (Service Auth) — in-worker defense in depth
    "ACCESS_MCP_AUD": "f9870472d373526eba8c8dac0334ff14ed5f51c76ceb9f8c0076b4cb10a36212"
  },
  "observability": { "enabled": true }
}
